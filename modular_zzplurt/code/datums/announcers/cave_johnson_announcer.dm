	welcome_messages = list(
		"Cave Johnson here. Welcome to your shift, astronauts, war heroes, Olympians, or whatever drifters Central Command scraped off the shuttle floor today. You're here because we want the best, and you are it. Or you owed sixty dollars. Either way, let's make some science.",
		"Welcome, gentlemen and ladies, to the frontier of corporate science. Cave Johnson speaking. Just a heads up: the bean counters told me we couldn't afford safety rails on a deep-space plasma research facility. Did it anyway! Bought 'em, sold 'em back, pocketed the difference. Now get to work.",
		"Cave Johnson here. Welcome aboard. Some of you may have noticed the release forms you signed in the arrivals shuttle were sixty pages of tiny print. Don't worry about it! Standard boilerplate saying if your organs turn into repulsion gel, Nanotrasen owns the gel.",
		"Testing, testing - is this thing on, Caroline? Alright, listen up! Cave Johnson here. You are about to embark on a full shift of unfiltered scientific progress. Remember our motto: we do what we must, because we can, and because the shareholders threatened to repossess my desk.",
	)

	alert_messages = list(
		"Cave Johnson here. Look alive, people, we've got a situation developing and the lab boys tell me ignoring it is no longer statistically viable.",
		"Attention test subjects and salaried employees! Cave Johnson speaking. Put down your combustible lemons and read the teleprompter.",
		"Cave Johnson here. Just interrupting your regularly scheduled workplace negligence with an urgent memo from the top floor.",
		"Caroline, patch me into the station PA - right now! Cave Johnson here. Listen up, because I am only saying this once.",
	)

	command_report_messages = list(
		"Cave Johnson here. The bean counters just faxed over a stack of classified paperwork to your communications consoles. Personally, I throw mine straight into the incinerator, but Caroline says you're legally required to read it.",
		"Attention! Cave Johnson speaking. Central Command just printed out a fresh batch of corporate directives at your communications consoles. Read 'em, memorize 'em, and if anyone from the Syndicate asks, eat the paper.",
		"Cave Johnson here. Just sent a status report to your communications consoles. The lab boys spent all morning redacting the parts that violate interstellar labor laws, so it should be a quick read.",
	)

	event_messages = list(
		ANNOUNCER_AIMALF = "Cave Johnson here. Bad news: the station AI has gone completely rogue and is trying to murder everyone. Good news: we finally proved artificial intelligence can feel pure, unadulterated spite! Grab a crowbar, smash its morality core, and bill the repairs to Science.",
		ANNOUNCER_ALIENS = "Cave Johnson here. Long-range sensors just picked up unidentified alien lifesigns boarding the station. If they're those mantis men I warned you about, pick up a laser rifle and follow the yellow line. You'll know when the test starts.",
		ANNOUNCER_ANIMES = "Cave Johnson here. Reality around the station is experiencing acute cartoon physics distortion. If your eyes grow to the size of dinner plates or your hair turns neon blue, do not panic - just write down how it feels for the lab boys.",
		ANNOUNCER_GRANOMALIES = "Cave Johnson here. We're reading a massive gravitational anomaly on the station. If you suddenly weigh four thousand pounds or start floating toward the ceiling fans, try to aim your head away from the blades.",
		ANNOUNCER_INTERCEPT = "Cave Johnson here. We just intercepted an encrypted transmission - probably those hacks at the Syndicate trying to steal our portal patents again. Check your communications consoles.",
		ANNOUNCER_IONSTORM = "Cave Johnson here. An ion storm just scrambled our silicon lawsets. If a cyborg offers you a lemon - do NOT take it! Demand to see the cyborg's manager! Make the AI rue the day it thought it could give Cave Johnson faulty laws!",
		ANNOUNCER_METEORS = "Cave Johnson here. Sensors show a swarm of meteors heading straight for the hull. The bean counters said meteor shields were too expensive, so if you see a giant flaming space rock coming through your department window, duck! Or catch it - pure moon rock is worth a fortune.",
		ANNOUNCER_OUTBREAK5 = "Cave Johnson here. We have a confirmed Level 5 biohazard outbreak aboard the station. Now, don't panic! It's probably just a harmless little flu we spliced with mantis DNA. Put on a sterile mask and keep testing.",
		ANNOUNCER_OUTBREAK6 = "Cave Johnson here. That biohazard just got bumped up to Level 6. The lab boys tell me the symptoms include coughing, fever, and spontaneous liquefaction of the spleen. Quarantine the affected sector immediately!",
		ANNOUNCER_OUTBREAK7 = "Cave Johnson here. Level 7 biohazard! That's the highest number on the chart, folks - Caroline had to draw a seven in red crayon! Whatever pathogen is loose out there is turning the crew inside out. Contain it or burn the whole wing down!",
		ANNOUNCER_POWEROFF = "Cave Johnson here. The power grid just flatlined. Did somebody unplug the Supermatter to charge their PDA? Engineers, get down to the substation and flip the breakers before the bean counters realize we're paying for darkness!",
		ANNOUNCER_POWERON = "Cave Johnson here. Power has been restored to the station! You may now resume electrocuting yourselves on the grilles at your own leisure.",
		ANNOUNCER_RADIATION = "Cave Johnson here. A radiation belt is passing right through the station. Now, the lab boys tell me a little ionizing radiation builds character, but unless you want a human-sized tumor growing out of your neck, get into maintenance right now!",
		ANNOUNCER_RADIATIONPASSED = "Cave Johnson here. The radiation storm has passed. If you're glowing green in the dark, congratulations: you've just saved the company twelve cents an hour on hallway lighting.",
		ANNOUNCER_SHUTTLECALLED = "Cave Johnson here. Somebody just called the emergency escape shuttle. Leaving already? Back in my day we didn't evacuate until at least ninety percent of the facility was submerged in neurotoxin! Pack your clipboards.",
		ANNOUNCER_SHUTTLEDOCK = "Cave Johnson here. The emergency escape shuttle has docked with the station. Please board in an orderly, scientific fashion - and leave company property behind, or I will personally deduct the shuttle fuel from your next of kin!",
		ANNOUNCER_SHUTTLERECALLED = "Cave Johnson here. Emergency shuttle has been recalled! That's the spirit! Nobody leaves until the testing is done, or until the station is a smoking crater. Get back to your posts!",
		ANNOUNCER_SHUTTLELEFT = "Cave Johnson here. The emergency shuttle has departed the station. If you're still on board reading this: congratulations, you've just been promoted to Permanent Overtime Test Subject!",
		ANNOUNCER_ANOMALIES = "Cave Johnson here. Sensors are picking up an unstable anomaly on the station. Don't poke it with a stick - poke it with an analyzer so we can patent whatever it does before it explodes!",
		ANNOUNCER_GRAVANOMALIES = "Cave Johnson here. Gravitational anomaly detected on the station. Watch your step, hold onto your hats, and if gravity reverses, remember that falling upward still counts as a workplace slip-and-fall.",
		ANNOUNCER_SPANOMALIES = "Cave Johnson here. Spatial wormholes are opening up all over the station. Look, if you step into a tear in the fabric of reality and end up in the vacuum of space, that is on you. Watch where you're walking!",
		ANNOUNCER_VORTEXANOMALIES = "Cave Johnson here. We've got a vortex anomaly tearing up the station. It's sucking in furniture, tools, and slow-moving assistants. Bolt your boots to the floor!",
		ANNOUNCER_MASSIVEBSPACEANOMALIES = "Cave Johnson here. A massive bluespace anomaly has materialized on board. The lab boys say it's bending four-dimensional space like a cheap pretzel. Get a containment team over there!",
		ANNOUNCER_TRANSLOCATION = "Cave Johnson here. Translocation anomaly detected! People and equipment are teleporting at random. If you materialize inside a solid steel wall, please hold your breath until an engineer with a pickaxe arrives.",
		ANNOUNCER_FLUXANOMALIES = "Cave Johnson here. Energetic flux anomaly on the scanners! Basically a giant ball of angry lightning looking for a ground wire. Keep your insulated gloves on, people!",
		ANNOUNCER_PYROANOMALIES = "Cave Johnson here. Pyroclastic anomaly detected! Apparently the air itself has decided to catch fire. Honestly, I respect the initiative - that's basically a self-combusting lemon without the peel!",
		ANNOUNCER_CARP = "Cave Johnson here. Space carp are migrating straight toward the station hull. Fish swimming in a vacuum! The lab boys said it was impossible, and now they're chewing through the reinforced glass. Shoot the fish!",
		ANNOUNCER_BLUESPACEARTY = "Cave Johnson here. Bluespace artillery is locked on and firing! Somebody paid for the big gun today - brace for impact!",
		ANNOUNCER_CAPTAIN = "Cave Johnson here. Your station Captain is commandeering my microphone for an announcement. Make it quick, Captain, I'm paying for this airtime by the syllable.",
		ANNOUNCER_GRAVGENOFF = "Cave Johnson here. The artificial gravity generator just went offline. Enjoy floating around like astronauts until Engineering figures out which fuse blew!",
		ANNOUNCER_GRAVGENON = "Cave Johnson here. Gravity generator is back online! Brace your knees, folks, because what goes up is coming down right now.",
		ANNOUNCER_GREYTIDE = "Cave Johnson here. Our automated security systems just suffered a catastrophic access override. Every door on the station is opening for people in grey jumpsuits. Lock your lockers and guard the toolboxes!",
		ANNOUNCER_COMMSBLACKOUT = "Cave Johnson here. Telecommunications just went dark due to an ionospheric disturbance. If you can't hear your coworkers screaming over the radio, just walk down the hall and listen for them in person!",
		ANNOUNCER_ELECTRICALSTORM = "Cave Johnson here. An electrical storm is surging through the APC network. Expect sparks, blown lightbulbs, and free defibrillation for anyone leaning against a power terminal.",
		ANNOUNCER_BRANDINTELLIGENCE = "Cave Johnson here. The vending machines have achieved sentience and started a union! They're throwing snacks at the crew at lethal velocity. Unplug 'em, tip 'em over, and take the candy!",
		ANNOUNCER_SPOOKY = "Cave Johnson here. The lab boys are reading ectoplasmic interference on the sensors. I don't believe in ghosts, and if I see one I'm charging it rent. Keep the lights on!",
		ANNOUNCER_ERTYES = "Cave Johnson here. An Emergency Response Team has been dispatched to your station. These are highly trained corporate troubleshooters, so try not to look like a problem when they kick the airlock open!",
		ANNOUNCER_MUTANTS = "Cave Johnson here. Biohazard scanners are picking up heavily mutated lifeforms on board. Remember: if it has more than two arms and isn't on the payroll, terminate it with extreme prejudice!",
		ANNOUNCER_KLAXON = "Cave Johnson here. That klaxon means maximum alert! Drop your coffee mugs and get to battle stations!",
		ANNOUNCER_ICARUS = "Cave Johnson here. Proximity alert! An unidentified vessel is making an aggressive approach vector toward the station!",
		ANNOUNCER_NRI_RAIDERS = "Cave Johnson here. Subspace radar just picked up hostile raiders inbound. Protect the company's research assets - and my portrait in the bridge!",
		ANNOUNCER_DEPARTMENTAL = "Cave Johnson here. Passing along a departmental priority bulletin. Read it and get back to testing.",
		ANNOUNCER_SHUTTLE = "Cave Johnson here. Shuttle traffic control update coming through the wire.",
		ANNOUNCER_GRAVGENBLACKOUT = "Cave Johnson here. The gravity generator is overloading! Hold onto a handrail unless you want to test terminal velocity when it snaps back on!",
		ANNOUNCER_METEORWARNING = "Cave Johnson here. Long-range telescopes spotted space debris on an intercept course. Keep away from exterior windows!",
		ANNOUNCER_AURORA_CAELUS = "Cave Johnson here. A harmless cloud of glowing space ions is brushing past the hull. The bean counters approved a five-minute break so you can stare out the window at the pretty colors. Don't get used to it!",
		ANNOUNCER_BUREAUCRATIC_ERROR = "Cave Johnson here. Some pencil-pusher in Organic Resources spilled coffee on the staffing manifest. Half your departments are overstaffed and the other half are empty. Figure it out!",
		ANNOUNCER_MARKET_CRASH = "Cave Johnson here. The galactic market just tanked, so we're hiking vending machine prices by three hundred percent to cover my yacht payments. Thank you for your sacrifice!",
		ANNOUNCER_MOUSE_MIGRATION = "Cave Johnson here. A horde of lab mice just escaped into the ventilation ducts. If they start glowing or solving mazes faster than the Research Director, let me know so we can hire 'em!",
		ANNOUNCER_SCRUBBER_OVERFLOW = "Cave Johnson here. The atmospheric scrubbers are backing up and spewing mystery sludge onto the floor. Don't breathe it, don't lick it, and definitely don't track it onto the bridge carpet!",
		ANNOUNCER_SHUTTLE_INSURANCE = "Cave Johnson here. Some space-faring insurance salesman is hailing the communications consoles. Tell 'em Cave Johnson doesn't buy insurance - disaster buys insurance against Cave Johnson!",
		ANNOUNCER_SUPERMATTER_SURGE = "Cave Johnson here. The Supermatter crystal is surging! The lab boys say if it hits critical delamination, it'll turn the whole sector into a crater. Engineers, get in there and cool that rock down!",
		ANNOUNCER_WISDOM_COW = "Cave Johnson here. Apparently there is a genetically uplifted, hyper-intelligent cow wandering the hallways dispensing life advice. Ask it how to stabilize plasma, then milk it!",
		ANNOUNCER_IMMOVABLE_ROD = "Cave Johnson here. What in the name of science was that?! A solid metal rod just phased straight through the hull at relativistic speed! Check for holes and patch the walls!",
		ANNOUNCER_SCRAMBLER_ANOMALY = "Cave Johnson here. A bioscrambler anomaly is loose on the station! If you walk near it without a biosuit, it'll swap your arms with your legs. Which, frankly, might improve productivity in Cargo!",
	)

	custom_alert_message = null
